{
  "name": "@messanga11/adapter-redis",
  "version": "0.1.0",
  "description": "Fail-closed Redis Functions adapters for Messanga11 server applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Messanga11/core.git",
    "directory": "packages/adapter-redis"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "biome check . && eslint .",
    "check:package": "npm run build && publint --strict && attw --pack . --no-definitely-typed --profile node16",
    "check:write": "biome check --write . && eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@messanga11/core": "^0.2.0"
  },
  "dependencies": {
    "redis": "^6.2.1",
    "zod": "^4.4.3"
  }
}
