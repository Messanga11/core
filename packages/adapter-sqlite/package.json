{
  "name": "@messanga11/adapter-sqlite",
  "version": "0.2.0",
  "description": "Development SQLite CRUD adapter for Messanga11 applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check:package": "npm run build && publint --strict && attw --pack . --no-definitely-typed --profile node16",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "peerDependencies": {
    "@messanga11/core": ">=0.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
