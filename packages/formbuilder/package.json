{
  "name": "@messanga11/formbuilder",
  "version": "0.1.4",
  "description": "Renderer-driven React form runtime for Messanga11 form contracts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check:package": "npm run build && publint --strict && attw --pack . --no-definitely-typed --profile node16",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5"
  },
  "peerDependencies": {
    "@messanga11/core": ">=0.6.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "react": "^19.1.1"
  }
}
