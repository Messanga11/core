{
  "name": "@messanga11/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-agnostic business kernel and reference adapters for Messanga11 applications.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "biome check . && eslint . && node scripts/check-boundaries.mjs",
    "check:packages": "npm run check:package --workspaces --if-present",
    "check:fixtures": "node scripts/verify-fixture-tarballs.mjs",
    "check:tarballs": "node scripts/verify-package-tarballs.mjs",
    "check:write": "biome check --write . && eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version": "changeset version",
    "release": "npm run build && npm run check:packages && npm run check:tarballs && npm run check:fixtures && changeset publish"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.10",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^10.0.1",
    "@trpc/server": "^11.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
